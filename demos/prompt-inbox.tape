Output assets/prompt-inbox-demo.svg
Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme { "name": "promptbox", "black": "#0d1117", "red": "#f85149", "green": "#3fb950", "yellow": "#e3b341", "blue": "#58a6ff", "magenta": "#a371f7", "cyan": "#39c5cf", "white": "#e6edf3", "brightBlack": "#8b949e" }
Type "prompt-inbox setup --repo BartoszOsiej/externum"
Enter
Sleep 1s
Type "   ✓ Repo configured · GitHub Issues connected"
Enter
Sleep 500ms
Type "# Send prompt → GitHub issue → agent handles it"
Enter
Sleep 800ms
